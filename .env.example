# Data source: "mock" (no credentials needed) or "google" (live Sheets API)
DASHBOARD_DATA_SOURCE=mock

# Google Sheets
GOOGLE_SHEETS_SPREADSHEET_ID=1jVpchfZkON-vCO1W-pIAMqHYhlWn-6FwL4yfUO2iCCM
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Paste the full private key including BEGIN/END lines, with real newlines
# replaced by \n (most .env parsers require this form).
GOOGLE_PRIVATE_KEY=

# Business timezone used for all "current month" / "today" calculations
BUSINESS_TIMEZONE=America/Toronto
